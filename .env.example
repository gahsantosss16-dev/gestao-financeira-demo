# Copie para .env.local (nunca versionado) e preencha com os valores do ambiente.
# Somente chaves PÚBLICAS podem usar o prefixo VITE_ (vão para o navegador).
# NUNCA coloque a service_role key, certificados digitais ou senhas aqui.

# development | qa | production
VITE_APP_ENV=development
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_SUPABASE_URL=https://<ref-do-projeto-de-desenvolvimento>.supabase.co
VITE_SUPABASE_ANON_KEY=<chave-publica-anon-ou-publishable>
